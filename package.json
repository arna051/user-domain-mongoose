{
  "name": "user-domain-mongoose",
  "version": "0.1.0",
  "description": "A scoped, privacy-conscious user profile and authorization domain for Mongoose",
  "keywords": [
    "mongoose",
    "users",
    "authorization",
    "rbac",
    "nestjs",
    "zod"
  ],
  "license": "MIT",
  "author": "Hippogriff Company",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.11"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./nestjs": {
      "types": "./dist/nestjs.d.ts",
      "import": "./dist/nestjs.js",
      "require": "./dist/nestjs.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run clean && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "libphonenumber-js": "^1.11.20",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10 <12",
    "mongoose": ">=8 <10",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "reflect-metadata": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    }
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@nestjs/common": "^11.0.11",
    "@types/node": "^22.13.4",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "mongoose": "^8.10.1",
    "prettier": "^3.5.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.1",
    "tsup": "^9.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
